{
  "expo": {
    "name": "microfinance-app",
    "slug": "microfinance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "microfinanceapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ginabun.microfinanceapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ginabun.microfinanceapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a37ad220-f15e-4a49-8412-c407ea61de40"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#1B5E20"
        }
      ],
      "expo-router"
    ]
  }
}

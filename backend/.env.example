APP_NAME=AHCoF Member API
APP_ENV=development
DEBUG=true
DEMO_MODE=true
# Local PostgreSQL container configuration. These are prototype-only values;
# replace the password in your untracked .env file if you need a different one.
POSTGRES_DB=ahcof
POSTGRES_USER=ahcof_user
POSTGRES_PASSWORD=ahcof_local_dev_password
DATABASE_URL=postgresql+psycopg://ahcof_user:ahcof_local_dev_password@localhost:5432/ahcof

